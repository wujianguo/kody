{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "kody-status",
	"main": "./worker.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	// One probe pass per minute; incidents open after two consecutive failures.
	"triggers": {
		"crons": ["* * * * *"],
	},
	// Deliberately independent from the main worker: the status page must stay
	// up when main-app deploys break or the app D1 database is down, so it
	// has its own domain and its own Durable Object storage.
	"routes": [
		{
			"pattern": "status.kody.apphub.work",
			"custom_domain": true,
		},
	],
	"services": [
		{
			// Worker-to-worker only. Not a public jobs hostname.
			"binding": "JOBS",
			"service": "kody-jobs",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "STATUS_STORE",
				"class_name": "StatusStore",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["StatusStore"],
		},
	],
	// Named favicon PNGs. `/` has no index.html, so the worker still
	// renders the page. `/favicon.ico` is worker-handled and 302s to the
	// current overall-status file.
	"assets": {
		"directory": "./public",
		"html_handling": "none",
		"not_found_handling": "none",
	},
	"vars": {
		"PRIMARY_ORIGIN": "https://kody.apphub.work",
		"PACKAGE_APP_ORIGIN": "https://kody-apps.apphub.work",
		"STATUS_PAGE_URL": "https://status.kody.apphub.work",
		// Fork deployment: operator address that receives incident alerts.
		"ALERT_EMAIL_TO": "lsjustin89@gmail.com",
		"ALERT_EMAIL_FROM": "kody@kody.apphub.work",
		"STATUS_ALERT_DAILY_LIMIT": "6",
		// Fork deployment: your Cloudflare account id; the matching
		// CLOUDFLARE_API_TOKEN with Email Sending permission is a Worker
		// secret set by the deploy workflow.
		"CLOUDFLARE_ACCOUNT_ID": "18503a03d3ee1fd75ac41f76c8d155b4",
		"BUILD_COMMIT": "REPLACE_AT_DEPLOY_TIME",
	},
}
